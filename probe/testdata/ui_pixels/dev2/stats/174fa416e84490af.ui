lt_stats_target:empty { x: 8px; y: 56px; width: 292px; height: 129px; z: 1000; ignore_event: true; visible: false;
#panel:color { x: 0px; y: 0px; width: 292px; height: 129px; color: #4b4a49ff; rounding: Uniform { rounding: 2; } ignore_event: true; z: 1001;
#shadow:color { x: 0px; y: 3px; width: 292px; height: 129px; color: #00000066; ignore_event: true; z: 1000; }
#fill:color { x: 1px; y: 1px; width: 290px; height: 127px; color: #211f1dff; ignore_event: true; z: 1002; }
#face:color { x: 10px; y: 46px; width: 64px; height: 64px; color: #4b4a49ff; rounding: Uniform { rounding: 2; } ignore_event: true; z: 1003;
#well:color { x: 1px; y: 1px; width: 62px; height: 62px; color: #0e0d0cff; ignore_event: true; z: 1004; }
#portrait:image { x: 1px; y: 1px; width: 62px; height: 62px; sample_linear: false; visible: false; ignore_event: true; z: 1005; }
#unit:image { x: 11px; y: 11px; width: 40px; height: 40px; source: "asset/lt_direct_control/ui/hud_minion"; color: #cbc9c7ff; visible: false; ignore_event: true; z: 1005; }
#badge:color { x: 0px; y: 46px; width: 26px; height: 18px; color: #1c1a18ee; ignore_event: true; z: 1006; }
#level:label { font: "asset/lt_direct_control/font/numeric"; x: 0px; y: 46px; width: 26px; height: 18px; size: 14; align_x: Center; align_y: Center; color: #eeececff; text: ""; ignore_event: true; z: 1007; }
}
