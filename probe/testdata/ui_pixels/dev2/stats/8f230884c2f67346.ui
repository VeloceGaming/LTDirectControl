lt_stats_own:empty { width: 1920px; height: 150px; anchor_x: 0.5; pivot_x: 0.5; anchor_y: 1; pivot_y: 1; z: 1000; ignore_event: true; visible: false;
#panel:color { x: 612px; y: 2px; width: 208px; height: 92px; color: #4b4a49ff; rounding: Uniform { rounding: 2; } ignore_event: true; z: 1001;
#shadow:color { x: 0px; y: 3px; width: 208px; height: 92px; color: #00000066; ignore_event: true; z: 1000; }
#fill:color { x: 1px; y: 1px; width: 206px; height: 90px; color: #211f1dff; ignore_event: true; z: 1002; }
